<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_node" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="g86"
                        android:fontFamily="@font/outfit"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleServer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pornește"
                    app:backgroundTint="@color/accent_emerald"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Hardware & System Monitoring Section -->
            <!-- 1. CPU & Baterie (Row 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- CPU Card with Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROCESOR (CPU)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCpuUsage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0% • 8 Cores"
                            android:textColor="@color/accent_cyan"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <ProgressBar
                            android:id="@+id/pbCpuUsage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_cpu" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Battery Card with Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BATERIE / ALIMENTARE"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="@color/accent_emerald"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <ProgressBar
                            android:id="@+id/pbBattery"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_battery" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2. MEMORIE RAM (Card cu bara Albastru, Galben, Verde) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MEMORIE RAM DISPOZITIV"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRamDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 GB Total"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Bara Tricoloră: Albastru (Utilizat), Galben (Cache), Verde (Disponibil) -->
                    <LinearLayout
                        android:id="@+id/layoutRamBarContainer"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_rounded_bar_container"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp">

                        <View
                            android:id="@+id/viewRamUsed"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="35"
                            android:background="@color/accent_blue" />

                        <View
                            android:id="@+id/viewRamRed"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="@color/accent_red" />

                        <View
                            android:id="@+id/viewRamCache"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="40"
                            android:background="@color/accent_yellow" />

                        <View
                            android:id="@+id/viewRamFree"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="20"
                            android:background="@color/accent_emerald" />
                    </LinearLayout>

                    <!-- Legenda explicativă culori -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvRamUsedLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔵 Sistem: --"
                            android:textColor="@color/text_secondary"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tvRamRedLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔴 RAM: --"
                            android:textColor="@color/text_secondary"
                            android:textSize="9.5sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvRamCacheLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🟡 Cache: --"
                            android:textColor="@color/text_secondary"
                            android:textSize="9.5sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvRamFreeLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🟢 Disponibil: --"
                            android:textColor="@color/text_secondary"
                            android:textSize="9.5sp"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. TRAFIC DATE REȚEA (Card Live RX / TX) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRAFIC REȚEA NOD g86 (SESIUNE ACTIVĂ)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Descarcare RX -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓ DESCĂRCARE (RX)"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTrafficRxSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 KB/s"
                                android:textColor="@color/accent_emerald"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tvTrafficRxTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: 0 MB"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="@color/border_color"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Incarcare TX -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ ÎNCĂRCARE (TX)"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTrafficTxSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 KB/s"
                                android:textColor="@color/accent_cyan"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tvTrafficTxTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: 0 MB"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dropdown Card: Adrese de conectare & Cod QR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Dropdown (Clickabil) -->
                    <LinearLayout
                        android:id="@+id/layoutAddressesHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Adrese de conectare &amp; Cod QR"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAddressesArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/accent_cyan"
                            android:textSize="14sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp" />
                    </LinearLayout>

                    <!-- Continut Expandabil Dropdown -->
                    <LinearLayout
                        android:id="@+id/layoutAddressesContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_color"
                            android:layout_marginBottom="14dp" />

                        <!-- Adresă Wi-Fi Locală -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adresă Rețea Locală (Wi-Fi / Clearnet):"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:id="@+id/tvLocalUrl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="http://g86.local:8080 (sau IP)"
                                android:textColor="@color/accent_cyan"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyLocal"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copiază"
                                android:textSize="12sp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Adresă Tor Hidden Service -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adresă Tor Hidden Service (.onion):"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:id="@+id/tvOnionUrl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Se generează cheile Tor..."
                                android:textColor="@color/accent_tor"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyOnion"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copiază"
                                android:textSize="12sp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Adresă Cloudflare Tunnel -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adresă Cloudflare Tunnel (HTTPS Global):"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tvCloudflareUrl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Se conectează la Cloudflare..."
                                android:textColor="@color/accent_orange"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyCloudflare"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copiază"
                                android:textSize="12sp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Secțiune Cod QR integrată în interiorul aceluiași dropdown -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_color"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scanează pentru Conectare Rapidă"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <ImageView
                                android:id="@+id/ivQrCode"
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:background="#FFFFFF"
                                android:padding="8dp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/tvQrLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QR pentru rețeaua locală"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dropdown Card: Conexiuni active -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConnections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header Dropdown (Clickabil) -->
                    <LinearLayout
                        android:id="@+id/layoutConnectionsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvConnectionsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Conexiuni active (0)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConnectionsArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/accent_cyan"
                            android:textSize="14sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp" />
                    </LinearLayout>

                    <!-- Continut Expandabil Dropdown (Implicit colapsat) -->
                    <LinearLayout
                        android:id="@+id/layoutConnectionsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_color"
                            android:layout_marginBottom="12dp" />

                        <!-- Lista dinamica de conexiuni -->
                        <LinearLayout
                            android:id="@+id/layoutConnectionsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Mesaj cand nu e nicio conexiune -->
                        <TextView
                            android:id="@+id/tvEmptyConnections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nicio conexiune activă în acest moment"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:padding="8dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Console Log -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Console Output &amp; Server Logs:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:layout_marginBottom="6dp" />

            <ScrollView
                android:id="@+id/scrollLogs"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#06090E"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#A0AEC0"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:text="[System] Initializare aplicatie g86...\n" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
